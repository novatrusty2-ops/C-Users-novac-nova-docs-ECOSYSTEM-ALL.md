{
  "name": "nova-wallet",
  "version": "1.9.5",
  "private": true,
  "description": "Nova Wallet \u2014 https://novablockchain.it.com/",
  "workspaces": [
    "apps/nova",
    "apps/novapay-portal",
    "apps/novapay-bridge",
    "apps/pouchpay-bridge"
  ],
  "scripts": {
    "dev": "npm run dev -w nova-wallet",
    "dev:nova": "npm run dev -w nova-wallet",
    "dev:novapay-portal": "npm run dev -w novapay-portal",
    "start:novapay-bridge": "npm run start -w novapay-bridge",
    "dev:novapay-bridge": "npm run dev -w novapay-bridge",
    "test:novapay-bridge": "npm run test -w novapay-bridge",
    "start:pouchpay-bridge": "npm run start -w pouchpay-bridge",
    "dev:pouchpay-bridge": "npm run dev -w pouchpay-bridge",
    "test:pouchpay-bridge": "npm run test -w pouchpay-bridge",
    "verify:pouchpay-routes": "node scripts/verify-pouchpay-routes.mjs",
    "verify:pouchpay-calldata-patch": "node scripts/verify-pouchpay-calldata-patch.mjs",
    "install:pouchpay-calldata": "bash scripts/install-pouchpay-calldata.sh",
    "install:pouchpay-calldata:wire": "bash scripts/install-and-wire-pouchpay-calldata.sh",
    "deploy:pouchpay-railway": "bash scripts/deploy-pouchpay-railway.sh",
    "burn:clones-pools": "node scripts/burn-clones-return-to-pools.mjs",
    "set:novapay-bridge-url": "node scripts/set-novapay-bridge-url.mjs",
    "build": "npm run build -w nova-wallet",
    "build:nova": "npm run build -w nova-wallet",
    "build:novapay-portal": "npm run build -w novapay-portal",
    "test": "npm run test -w nova-wallet",
    "test:nova": "npm run test -w nova-wallet",
    "typecheck": "npm run typecheck -w nova-wallet",
    "typecheck:novapay-portal": "npm run typecheck -w novapay-portal",
    "fetch-api": "bash scripts/fetch-api.sh",
    "sync": "python3 scripts/sync-ecosystem.py",
    "sync:ecosystem": "bash scripts/fetch-api.sh && python3 scripts/sync-ecosystem.py",
    "verify:ecosystem": "node scripts/verify-ecosystem.mjs",
    "test:novapay": "node scripts/novapay-sandbox-test.mjs",
    "test:novapay:to": "node scripts/novapay-to-sandbox-e2e.mjs",
    "test:novapay-accounts": "node scripts/novapay-accounts-smoke.mjs",
    "test:novapay:all": "npm run test:novapay && npm run test:novapay:to && npm run test:novapay-accounts && npm run test:novapay-bridge",
    "check:novapay-onboarding": "python3 scripts/check-novapay-onboarding.py",
    "set:pouchpay-bridge-url": "node scripts/set-pouchpay-bridge-url.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
