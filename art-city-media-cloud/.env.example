# Art City Media Cloud — Phase 1
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
JWT_SECRET=dev-change-me-art-city-media-cloud
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database
DATABASE_URL=postgresql+psycopg://artcity:artcity@localhost:5432/artcity

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=artcity
S3_SECRET_KEY=artcitysecret
S3_BUCKET=artcity-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Upload
UPLOAD_PART_SIZE_BYTES=5242880
SIGNED_URL_EXPIRE_SECONDS=3600

# Seed
SEED_ADMIN_EMAIL=admin@artcity.example
SEED_ADMIN_PASSWORD=ChangeMeNow!
SEED_TENANT_NAME=Art City
SEED_TENANT_SLUG=art-city

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
